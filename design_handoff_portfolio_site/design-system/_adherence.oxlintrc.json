{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/links/**",
              "components/navigation/**",
              "ui_kits/portfolio-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Sans))/i]",
        "message": "Font not provided by the design system. Available: Instrument Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|onClick|key|ref|className|style|children)$/]",
        "message": "<BackMark> doesn't accept that prop. Declared props: href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ForwardLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|size|onClick|key|ref|className|style|children)$/]",
        "message": "<ForwardLink> doesn't accept that prop. Declared props: children, href, size, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ForwardLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:large|small)$/]",
        "message": "<ForwardLink> size must be one of 'large' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|active|onClick|key|ref|className|style|children)$/]",
        "message": "<ProjectLink> doesn't accept that prop. Declared props: children, href, active, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|dates|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, dates."
      },
      {
        "selector": "JSXOpeningElement[name.name='WritingBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|image|caption|key|ref|className|style|children)$/]",
        "message": "<WritingBlock> doesn't accept that prop. Declared props: children, image, caption."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "BackMark": {
        "replaces": []
      },
      "ForwardLink": {
        "replaces": []
      },
      "ProjectLink": {
        "replaces": []
      },
      "SectionHeader": {
        "replaces": []
      },
      "WritingBlock": {
        "replaces": []
      }
    },
    "tokens": [
      "--black",
      "--border-hairline",
      "--duration-fast",
      "--duration-normal",
      "--ease-standard",
      "--font-sans",
      "--gray-100",
      "--gray-300",
      "--gray-500",
      "--gray-700",
      "--green-100",
      "--green-200",
      "--green-50",
      "--leading-normal",
      "--leading-snug",
      "--leading-tight",
      "--radius-md",
      "--radius-sm",
      "--space-1",
      "--space-10",
      "--space-2",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-7",
      "--space-8",
      "--space-9",
      "--surface-bg",
      "--surface-bg-raised",
      "--surface-line",
      "--text-body",
      "--text-display",
      "--text-h1",
      "--text-h2",
      "--text-micro",
      "--text-on-dark",
      "--text-primary",
      "--text-secondary",
      "--text-small",
      "--text-tertiary",
      "--tracking-normal",
      "--tracking-tight",
      "--tracking-wide",
      "--weight-bold",
      "--weight-medium",
      "--weight-regular",
      "--weight-semibold",
      "--white"
    ],
    "tokenKinds": {
      "--green-50": "color",
      "--green-100": "color",
      "--green-200": "color",
      "--black": "color",
      "--white": "color",
      "--gray-100": "color",
      "--gray-300": "color",
      "--gray-500": "color",
      "--gray-700": "color",
      "--surface-bg": "color",
      "--surface-bg-raised": "color",
      "--surface-line": "color",
      "--text-primary": "font",
      "--text-secondary": "font",
      "--text-tertiary": "font",
      "--text-on-dark": "font",
      "--border-hairline": "color",
